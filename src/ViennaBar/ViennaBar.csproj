<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ViennaBar</AssemblyName>
    <RootNamespace>ViennaBar</RootNamespace>
    <Version>0.1.0</Version>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- PublishAot: BLOQUEADO por COM interop (D2D/DWrite/shell COM no soportado
         en AOT .NET 8 sin ComWrappers). Tarea F2: migrar a ComWrappers SG o
         CsWin32 allowMarshaling=false. Por ahora: self-contained sin trim. -->
    <PublishAot Condition="'$(PublishAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ViennaBar.Gfx\ViennaBar.Gfx.csproj" />
    <ProjectReference Include="..\ViennaBar.Shell\ViennaBar.Shell.csproj" />
  </ItemGroup>
</Project>
