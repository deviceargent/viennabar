<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ViennaBar</AssemblyName>
    <RootNamespace>ViennaBar</RootNamespace>
    <Version>0.1.0</Version>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- PublishAot: ACTIVO desde F2.1b (vtables crudas en Gfx+Shell, CCWs
         manuales, cero COM interop). `dotnet publish -r win-x64` genera
         SIEMPRE el exe AOT (~2MB). Incondicional a propósito: PublishAot
         solo actúa en publish, el build normal no se ve afectado. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ViennaBar.Gfx\ViennaBar.Gfx.csproj" />
    <ProjectReference Include="..\ViennaBar.Shell\ViennaBar.Shell.csproj" />
  </ItemGroup>
</Project>
