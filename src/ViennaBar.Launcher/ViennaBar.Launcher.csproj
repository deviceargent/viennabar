<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ViennaBar.Launcher</AssemblyName>
    <RootNamespace>ViennaBar.Launcher</RootNamespace>
    <!-- AOT: arranque frio <50ms exigido por M2 (wrapper IFEO). Cero
         dependencias: solo BCL + DllImport crudos (nada de CsWin32). -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ViennaBar.Shell.Tests" />
  </ItemGroup>

</Project>
